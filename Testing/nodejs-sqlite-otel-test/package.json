{
  "name": "nodejs-sqlite-otel-test",
  "version": "1.0.0",
  "description": "Small Express + SQLite app for testing OpenTelemetry (EDOT / upstream) ingest into Elastic",
  "main": "app.js",
  "private": true,
  "scripts": {
    "start": "node app.js",
    "start:edot": "node --import @elastic/opentelemetry-node app.js",
    "start:upstream": "node --require @opentelemetry/auto-instrumentations-node/register app.js"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@elastic/opentelemetry-node": "^1.20.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.81.2",
    "better-sqlite3": "^12.11.1",
    "express": "^5.3.0",
    "pino": "^10.4.0"
  }
}
