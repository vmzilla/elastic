# App-side settings. Nothing to change when the Collector runs on the same machine (docker compose in this folder).
# If the Collector runs elsewhere, change the host in OTEL_EXPORTER_OTLP_ENDPOINT.
OTEL_SERVICE_NAME=sqlite-edot-to-collector
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=test,service.version=1.0.0
# EDOT Node.js has log sending off by default
ELASTIC_OTEL_NODE_ENABLE_LOG_SENDING=true
