# >>> EDIT THE TWO <...> VALUES BELOW, EVERYTHING ELSE CAN STAY AS IS <<<
# Elasticsearch endpoint (NOT the APM URL), e.g. https://<deployment>.es.<region>.<csp>.cloud.es.io  (add :9200 for self-managed)
ELASTIC_ENDPOINT=https://<your-elasticsearch-host>
# Elasticsearch API key, the "encoded" value returned by POST /_security/api_key
ELASTIC_API_KEY=<your-elasticsearch-api-key-encoded>

# Keep the Agent version in line with your Elastic Stack version (9.4.2 here)
COLLECTOR_IMAGE=docker.elastic.co/elastic-agent/elastic-agent:9.4.2
