{
  "name": "nodejs-sqlite-contrib-apm-server",
  "version": "1.0.0",
  "description": "Express + SQLite app instrumented with the upstream (contrib) OpenTelemetry Node.js SDK, sending OTLP to an Elastic APM Server",
  "main": "app.js",
  "private": true,
  "scripts": {
    "start": "node --env-file=.env --require ./tracing.js app.js",
    "start:plain": "node app.js"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.81.2",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.223.2",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.223.2",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.223.2",
    "@opentelemetry/sdk-logs": "^0.223.2",
    "@opentelemetry/sdk-metrics": "^2.12.1",
    "@opentelemetry/sdk-node": "^0.223.2",
    "better-sqlite3": "^12.11.1",
    "express": "^5.3.0",
    "pino": "^10.4.0"
  }
}
