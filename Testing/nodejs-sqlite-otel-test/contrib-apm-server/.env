# >>> EDIT THE TWO <...> VALUES BELOW, EVERYTHING ELSE CAN STAY AS IS <<<
# APM Server URL. Elastic Cloud: https://<id>.apm.<region>.<csp>.cloud.es.io:443  Self-managed: https://<host>:8200
OTEL_EXPORTER_OTLP_ENDPOINT=https://<your-apm-server-host>:443
# APM secret token (or: "Authorization=ApiKey <your-apm-api-key>"). Keep the quotes, the value contains a space.
OTEL_EXPORTER_OTLP_HEADERS="Authorization=Bearer <your-apm-secret-token>"

OTEL_SERVICE_NAME=sqlite-contrib-to-apm
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=test,service.version=1.0.0
OTEL_METRIC_EXPORT_INTERVAL=30000
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
